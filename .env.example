# Backend API (use LAN IP when testing on a physical device, e.g. http://192.168.1.10:5000)
EXPO_PUBLIC_API_URL=http://localhost:5000

# Google OAuth — must match backend GOOGLE_CLIENT_ID (Web client ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Optional platform-specific client IDs (defaults to web client ID)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
